# Copia este archivo como .env y cambia los valores. El .env no se sube.
# Los valores salen de tu proyecto de Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-llave-publica

# Llave secreta: solo en el servidor, nunca en el navegador ni en el repo.
SUPABASE_SECRET_KEY=tu-llave-secreta

# --- Práctica 1: API de lugares (compose.yaml) ---
DB_USER=lugares_user
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=lugares_db
JWT_SECRET=cambia_esta_llave_larga_y_secreta
JWT_EXPIRES_IN=1h
